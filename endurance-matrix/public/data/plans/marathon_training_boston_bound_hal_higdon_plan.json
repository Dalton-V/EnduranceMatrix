    "coaching_guidance": [
      {
        "topic": "Strength and Terrain",
        "text": "Include uphill and downhill running to prepare for the course. Pair easy Monday or Wednesday running with strength work when practical."
      },
      {
        "topic": "Tuesday Repeats",
        "text": "Alternate hills with 800-meter repeats. The schedule specifies downhill repetitions for the hill workouts."
      },
      {
        "topic": "Weekend Runs",
        "text": "Practice marathon pace on designated Saturdays, and alternate timed and distance-based long runs before the taper."
      }
