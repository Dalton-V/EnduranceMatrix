      "strength_training": {
        "id": "strength_training",
        "label": "Strength Training",
        "category": "strength",
        "discipline": "gym",
        "description": "Many who consider ourselves pure runners sometimes think, we really should try strength training some time. Now is that time! My Spring Training Program suggests gym workouts two days a week. Run for half an hour, then stop at the gym. Or devote a full day to strength training. I usually recommend light weights and high reps, but you need to determine what works best for you, sometimes with the aid of a personal trainer.",
        "intensity": "moderate",
        "effort_zone": 3,
        "notes": null
      },
      "tempo_run": {
        "id": "tempo_run",
        "label": "Tempo Run",
        "category": "threshold",
        "discipline": "running",
        "description": "A sustained faster run intended to improve lactate-threshold fitness and controlled speed endurance.",
        "intensity": "moderate-high",
        "effort_zone": 4,
        "notes": null
      }
