    "coaching_guidance": [
      {
        "topic": "Long Runs",
        "text": "Build from 4 to 12 miles on Sundays and taper for the race. Run at a conversational effort, generally 30–90 seconds per mile or more below goal pace."
      },
      {
        "topic": "Cross-Training",
        "text": "Use easy aerobic cross-training on Mondays, increasing from about 30 to 60 minutes."
      },
      {
        "topic": "Race Pace",
        "text": "Use your goal half marathon pace on the scheduled Saturday pace runs."
      },
      {
        "topic": "Tune-Up Races",
        "text": "The week 6 5K and week 9 10K are optional. Choose events that fit your calendar."
      }
    ],
