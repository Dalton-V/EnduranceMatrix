      "easy_run": {
        "id": "easy_run",
        "label": "Easy Run",
        "category": "endurance",
        "discipline": "running",
        "description": "An easy aerobic run done at a comfortable, conversational pace to build endurance while limiting fatigue.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "race": {
        "id": "race",
        "label": "Race",
        "category": "race-specific",
        "discipline": "running",
        "description": "A race effort or tune-up event used to practice pacing and measure current fitness.",
        "intensity": "high",
        "effort_zone": 5,
        "notes": null
      },
      "rest": {
        "id": "rest",
        "label": "Rest",
        "category": "recovery",
        "discipline": null,
        "description": "Rest days are as vital as training days. They give your muscles time to recover so you can run again. Actually, your muscles will build in strength as you rest.",
        "intensity": "none",
        "effort_zone": 0,
        "notes": null
      },
      "walk": {
        "id": "walk",
        "label": "Walk",
        "category": "recovery",
        "discipline": "running",
        "description": "Don't worry about how fast you walk, or how much distance you cover. Begin with about 30 minutes and add 5 minutes a week until you peak with a full hour in Week 7.",
        "intensity": "low",
        "effort_zone": 1,
        "notes": null
      }
    },
    "coaching_guidance": [
      {
        "topic": "Rest",
        "text": "Rest days are as vital as training days. They give your muscles time to recover so you can run again. Actually, your muscles will build in strength as you rest."
      },
      {
        "topic": "Run",
        "text": "Don't worry about how fast you run; just cover the distance-or approximately the distance suggested. Ideally, you should be able to run at a pace that allows you to converse comfortably while you do so."
      },
      {
        "topic": "Run/Walk",
        "text": "There's nothing in the rules that suggests you have to run continuously, either in training or in the 5K race itself. Run until fatigued; walk until recovered."
      },
      {
        "topic": "Walk",
        "text": "Don't worry about how fast you walk, or how much distance you cover. Begin with about 30 minutes and add 5 minutes a week until you peak with a full hour in Week 7."
      }
    ],
