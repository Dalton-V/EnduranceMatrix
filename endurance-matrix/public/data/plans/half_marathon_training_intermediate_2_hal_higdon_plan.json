    "coaching_guidance": [
      {
        "topic": "Easy and Long Runs",
        "text": "Keep easy and long runs conversational. The Sunday long run builds from 5 to 12 miles before race week."
      },
      {
        "topic": "Intervals and Tempo",
        "text": "Alternate 400-meter repeats at roughly 5K pace with continuous tempo runs. Walk or jog between repeats, and warm up and cool down."
      },
      {
        "topic": "Race Pace and Tune-Ups",
        "text": "Use goal half marathon pace on pace days. The schedule includes tune-up 5K, 10K and 15K races."
      },
      {
        "topic": "Cross-Training and Rest",
        "text": "Choose easy aerobic cross-training on Mondays and rest on Fridays. Adjust sessions to fit your recovery and schedule."
      }
    ],
