        "id": "easy_run",
        "label": "Easy Run",
        "category": "endurance",
        "discipline": "running",
        "description": "An easy aerobic run done at a comfortable, conversational pace to build endurance while limiting fatigue.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "interval_400": {
        "id": "interval_400",
        "label": "400 m Repeats",
        "category": "speed",
        "discipline": "running",
        "description": "Run the prescribed repeats with recovery between efforts. The distance counts the repeats.",
