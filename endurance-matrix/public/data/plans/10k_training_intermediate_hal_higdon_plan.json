    "workout_definitions": {
      "cross_training": {
        "id": "cross_training",
        "label": "Cross Training",
        "category": "active-recovery",
        "discipline": "any",
        "description": "What form of cross-training works best for runners preparing for a 10K race? It could be swimming, or cycling, walking, other forms of aerobic training or some combination that could include strength training (best done after easy runs). What cross-training you select depends on your personal preference. Cross-training days should be considered easy days that allow you to recover from the hard running you do the rest of the week.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "easy_run": {
        "id": "easy_run",
        "label": "Easy Run",
        "category": "endurance",
        "discipline": "running",
        "description": "An easy aerobic run done at a comfortable, conversational pace to build endurance while limiting fatigue.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "long_run": {
        "id": "long_run",
        "label": "Long Run",
        "category": "endurance",
        "discipline": "running",
        "description": "As an experienced runner, you probably already do a long run on the weekends anyway. This schedule suggests a slight increase in distance as you get closer to race date: from 4 to 8 miles. Don't get hung up on running these workouts too fast. Run at a comfortable, conversational pace.",
        "intensity": "low-moderate",
        "effort_zone": 2,
        "notes": null
      },
