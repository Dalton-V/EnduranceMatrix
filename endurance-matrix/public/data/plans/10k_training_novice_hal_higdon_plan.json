      "rest": {
        "id": "rest",
        "label": "Rest",
        "category": "recovery",
        "discipline": null,
        "description": "The first word you encounter in the 10K Novice Program, and in many of my other training plans from 5K to the marathon, is \"rest.\" I suggest you rest on Fridays before your weekend workouts and on Mondays after those workouts. You can't train efficiently if fatigued. Take rest days seriously.",
        "intensity": "none",
        "effort_zone": 0,
        "notes": null
      },
      "strength_training": {
        "id": "strength_training",
        "label": "Strength Training",
        "category": "strength",
        "discipline": "gym",
        "description": "Have you lifted before? If not, you may not want to start the same time you start a running program. Tuesdays and Thursdays are good days for strength training- after your run. Stretching also is important to keep your muscles loose.",
        "intensity": "moderate",
        "effort_zone": 3,
        "notes": null
      }
