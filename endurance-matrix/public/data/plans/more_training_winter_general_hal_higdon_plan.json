        "discipline": "any",
        "description": "A non-running aerobic session used to maintain fitness while reducing running impact.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "easy_run": {
        "id": "easy_run",
        "label": "Easy Run",
        "category": "endurance",
        "discipline": "running",
        "description": "An easy aerobic run done at a comfortable, conversational pace to build endurance while limiting fatigue.",
        "intensity": "low",
        "effort_zone": 2,
        "notes": null
      },
      "long_run": {
        "id": "long_run",
        "label": "Long Run",
        "category": "endurance",
        "discipline": "running",
        "description": "Run at a comfortable effort unless the workout includes a specific pace cue.",
