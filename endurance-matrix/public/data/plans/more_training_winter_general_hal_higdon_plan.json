    "coaching_guidance": [
      {
        "topic": "Easy Effort",
        "text": "Keep the Monday and Wednesday runs easy. If footing makes outdoor running difficult, an indoor treadmill is an option."
      },
      {
        "topic": "Long Runs",
        "text": "Tuesdays are medium-long runs. Saturday long runs rotate through 60, 75 and 90 minutes."
      },
      {
        "topic": "Strength and Cross-Training",
        "text": "Pair Wednesday running with stretching or strength work. On Sundays, choose an aerobic activity such as walking, indoor training, skiing or snowshoeing."
      },
      {
        "topic": "Final Race",
        "text": "Choose a race that suits your schedule and the conditions in week 13. Higdon leaves the distance open."
      }
    ],
