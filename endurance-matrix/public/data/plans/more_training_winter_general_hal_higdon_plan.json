        "effort_zone": 5,
        "notes": null
      },
      "rest": {
        "id": "rest",
        "label": "Rest",
        "category": "recovery",
        "discipline": null,
        "description": "A no-training day used to absorb prior workouts and promote recovery.",
        "intensity": "none",
        "effort_zone": 0,
        "notes": null
      },
      "tempo_run": {
        "id": "tempo_run",
        "label": "Tempo Run",
        "category": "threshold",
        "discipline": "running",
        "description": "A sustained faster run intended to improve lactate-threshold fitness and controlled speed endurance.",
        "intensity": "moderate-high",
        "effort_zone": 4,
        "notes": null
      }
