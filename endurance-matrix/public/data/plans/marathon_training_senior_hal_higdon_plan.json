    "coaching_guidance": [
      {
        "topic": "Weekly Pattern",
        "text": "Rest Monday and Saturday. Run Tuesday, Thursday and Sunday. Use Wednesday and Friday for stretching and strength work, or substitute aerobic cross-training."
      },
      {
        "topic": "Long Runs and Taper",
        "text": "The schedule counts down to the marathon. The 20-mile long run comes in the third week from the race, followed by a two-week taper."
      }
