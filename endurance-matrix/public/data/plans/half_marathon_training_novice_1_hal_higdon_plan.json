      },
      "strength_training": {
        "id": "strength_training",
        "label": "Strength Training",
        "category": "strength",
        "discipline": "gym",
        "description": "If you never have lifted weights before, now might not be the best time to start. Wait until after completing this program. If you are an experienced lifter, continue, although you may want to cut back somewhat as the mileage builds near the end. Tuesdays and Thursdays after your run would be good days on which to lift.",
        "intensity": "moderate",
