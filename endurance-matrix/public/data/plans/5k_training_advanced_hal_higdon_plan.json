    "id": "5k_training_advanced",
    "name": "5K Training: Advanced",
    "author": "Hal Higdon",
    "version": "1.0",
    "created_at": null,
    "description": "Hal Higdon has designed his Advanced 5K training plan for veteran runners looking to achieve maximum performance in the speedy 5K distance. Try the interactive program today.",
    "tags": [
      "5k",
      "advanced",
      "road-running"
    ],
