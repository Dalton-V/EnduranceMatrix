  "plan": {
    "id": "5k_training_intermediate",
    "name": "5K Training: Intermediate",
    "author": "Hal Higdon",
    "version": "1.0",
    "created_at": null,
    "description": "IF YOU HAVE RUN A NUMBER OF RACES AT THE 5K DISTANCE, you probably are not going to be content to merely finish your 5K race. You'd like to finish it with grace, in style and maybe improve your time (known as setting a Personal Record, or PR). This training schedule will take you to ... Continue reading \"Intermediate\"",
