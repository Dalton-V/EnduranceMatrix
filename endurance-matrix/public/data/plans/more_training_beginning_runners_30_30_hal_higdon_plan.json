    "coaching_guidance": [
      {
        "topic": "30-Minute Session",
        "text": "Walk for 10 minutes, alternate easy jogging and walking for 15 minutes, then finish with 5 minutes of walking."
      },
      {
        "topic": "Progression",
        "text": "Start with 30 seconds of jogging followed by as much walking as you need. Once comfortable, alternate 30 seconds of jogging with 30 seconds of walking."
      },
      {
        "topic": "Cadence",
        "text": "Repeat for 30 sessions. Higdon describes daily and every-other-day options. The calendar shows a sample pattern of six sessions a week."
      }
    ],
